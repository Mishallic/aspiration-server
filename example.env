# Copy to .env and edit. Every value has a safe default for local development,
# so `docker compose up` or `npm start` works with no changes.
# The server validates this at startup and refuses to start on unsafe production settings.

# ---- Core ----
NODE_ENV=development
PORT=8080
# The public base URL of this server. Must be https in production (localhost is exempt).
PUBLIC_URL=http://localhost:8080
APP_NAME=Your app
# Database. Omit to use a local SQLite file (./data/auth.sqlite). For production use Postgres:
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to the number of proxies in front of you (or true) so client IPs are read correctly.
# TRUST_PROXY=1
# Comma-separated browser origins allowed by CORS. Empty allows all in dev, none in prod.
# CORS_ORIGINS=https://app.example.com
# Comma-separated exact URLs the web OAuth flow may redirect back to. Required for web OAuth.
# ALLOWED_REDIRECT_URLS=https://app.example.com/auth/callback

# ---- Tokens ----
# Audience claim your backends check when verifying access tokens.
JWT_AUDIENCE=app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Leave empty to auto-generate a signing key and store it in the database (rotate with the CLI).
# To pin the key instead, set an RSA private key in PKCS8 PEM (newlines as \n).
# SIGNING_KEY=

# ---- Email (verification and password reset) ----
# When true, users must confirm their email before they can log in.
REQUIRE_EMAIL_VERIFICATION=false
# SMTP connection string. Without it, dev prints emails to the console; prod skips sending.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=Auth <no-reply@localhost>
# Optional: send verification/reset links to your own client screens instead of the built-in pages.
# PASSWORD_RESET_URL=https://app.example.com/reset-password
# EMAIL_VERIFIED_REDIRECT_URL=https://app.example.com/email-confirmed

# ---- Social sign-in (all optional; leave blank to disable) ----
# Google: web redirect needs the id + secret; native (mobile) needs the client IDs below.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_NATIVE_CLIENT_IDS=ios-id.apps.googleusercontent.com,android-id.apps.googleusercontent.com
# GitHub: web redirect only.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Apple: native (mobile/web) ID-token sign-in. One or more client IDs / service IDs.
# APPLE_CLIENT_IDS=com.example.app

# ---- Webhooks (optional) ----
# Receive signed user.created / user.deleted events. Secret must be 24+ chars.
# WEBHOOK_URL=https://your-app.example.com/webhooks/auth
# WEBHOOK_SECRET=

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
