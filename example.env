# Copy to .env and fill in. Everything is optional for local development.

PORT=8080
# Required in production. Signs the JWTs.
SECRET=change-me
JWT_EXPIRES_IN=7d
# Allowed browser origin for CORS. Use your client URL in production.
CORS_ORIGIN=*

# Database. Defaults to a local SQLite file, so no setup is needed.
DB_DIALECT=sqlite
DB_STORAGE=./dev.sqlite
# For MySQL or Postgres, set DB_DIALECT=mysql or postgres and either
# DB_CONNECTION_STRING or the separate fields below.
# DB_CONNECTION_STRING=postgres://user:password@localhost:5432/aspiration
# DB_NAME=aspiration
# DB_USER=user
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_PORT=5432

# Google sign-in. Leave blank to disable the /oauth/google routes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/oauth/google/callback
# Optional. Where to send the user after Google sign-in, with the JWT in the
# URL fragment (for example a mobile deep link). Without it the callback
# returns JSON.
CLIENT_OAUTH_REDIRECT=
