{
  "name": "aspiration-server",
  "version": "2.0.0",
  "description": "Self-hosted auth server: email/password, Google, GitHub and Apple sign-in, refresh tokens and JWKS. Runs in one container.",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "migrate": "node src/cli.js migrate",
    "cli": "node src/cli.js"
  },
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "argon2@0.45.1": true
  }
}
